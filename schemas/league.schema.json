{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttman12/matchlens-pl-hackathon/schemas/league.schema.json",
  "x-schema-version": "1.0.0",
  "$defs": {
    "Attributes": {
      "additionalProperties": false,
      "description": "Player ratings the simulator draws on, 1 to 99.",
      "properties": {
        "pace": {
          "maximum": 99,
          "minimum": 1,
          "title": "Pace",
          "type": "integer"
        },
        "acceleration": {
          "maximum": 99,
          "minimum": 1,
          "title": "Acceleration",
          "type": "integer"
        },
        "passing": {
          "maximum": 99,
          "minimum": 1,
          "title": "Passing",
          "type": "integer"
        },
        "vision": {
          "maximum": 99,
          "minimum": 1,
          "title": "Vision",
          "type": "integer"
        },
        "finishing": {
          "maximum": 99,
          "minimum": 1,
          "title": "Finishing",
          "type": "integer"
        },
        "tackling": {
          "maximum": 99,
          "minimum": 1,
          "title": "Tackling",
          "type": "integer"
        },
        "keeping": {
          "maximum": 99,
          "minimum": 1,
          "title": "Keeping",
          "type": "integer"
        },
        "discipline": {
          "maximum": 99,
          "minimum": 1,
          "title": "Discipline",
          "type": "integer"
        },
        "stamina": {
          "maximum": 99,
          "minimum": 1,
          "title": "Stamina",
          "type": "integer"
        }
      },
      "required": [
        "pace",
        "acceleration",
        "passing",
        "vision",
        "finishing",
        "tackling",
        "keeping",
        "discipline",
        "stamina"
      ],
      "title": "Attributes",
      "type": "object"
    },
    "Club": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "pattern": "^[a-z]{3}$",
          "title": "Team Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "title": "Short Name",
          "type": "string"
        },
        "city": {
          "title": "City",
          "type": "string"
        },
        "stadium": {
          "title": "Stadium",
          "type": "string"
        },
        "colours": {
          "$ref": "#/$defs/Colours"
        },
        "rating": {
          "description": "Pre-match team strength",
          "maximum": 99,
          "minimum": 1,
          "title": "Rating",
          "type": "integer"
        },
        "formation": {
          "description": "Default formation, e.g. 4-3-3",
          "title": "Formation",
          "type": "string"
        },
        "rival_ids": {
          "items": {
            "pattern": "^[a-z]{3}$",
            "type": "string"
          },
          "title": "Rival Ids",
          "type": "array"
        },
        "squad": {
          "items": {
            "$ref": "#/$defs/Player"
          },
          "title": "Squad",
          "type": "array"
        }
      },
      "required": [
        "team_id",
        "name",
        "short_name",
        "city",
        "stadium",
        "colours",
        "rating",
        "formation",
        "squad"
      ],
      "title": "Club",
      "type": "object"
    },
    "Colours": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Primary",
          "type": "string"
        },
        "secondary": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Secondary",
          "type": "string"
        },
        "text": {
          "description": "Shirt number colour, readable on primary",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "primary",
        "secondary",
        "text"
      ],
      "title": "Colours",
      "type": "object"
    },
    "Player": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "title": "Player Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "description": "Name shown on name tags, e.g. a surname",
          "title": "Short Name",
          "type": "string"
        },
        "shirt": {
          "maximum": 99,
          "minimum": 1,
          "title": "Shirt",
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "role": {
          "description": "Detailed role, e.g. CB, LW, DM, ST",
          "title": "Role",
          "type": "string"
        },
        "foot": {
          "enum": [
            "left",
            "right",
            "both"
          ],
          "title": "Foot",
          "type": "string"
        },
        "top_speed_kmh": {
          "maximum": 40,
          "minimum": 20,
          "title": "Top Speed Kmh",
          "type": "number"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "player_id",
        "name",
        "short_name",
        "shirt",
        "position",
        "role",
        "foot",
        "top_speed_kmh",
        "attributes"
      ],
      "title": "Player",
      "type": "object"
    },
    "Position": {
      "enum": [
        "GK",
        "DF",
        "MF",
        "FW"
      ],
      "title": "Position",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``league.json``: the fixed universe a season is played in.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "league_id": {
      "title": "League Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "clubs": {
      "items": {
        "$ref": "#/$defs/Club"
      },
      "title": "Clubs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "league_id",
    "name",
    "clubs"
  ],
  "title": "League",
  "type": "object"
}
