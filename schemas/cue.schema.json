{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttman12/matchlens-pl-hackathon/schemas/cue.schema.json",
  "x-schema-version": "1.0.0",
  "$defs": {
    "AnalystDetail": {
      "additionalProperties": false,
      "description": "Extra depth shown when the evidence dropdown is opened.",
      "properties": {
        "event_ids": {
          "items": {
            "pattern": "^m\\d{3,}-e\\d{4,}$",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "pass_map": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Pass Map",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "AnalystDetail",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "shot": {
          "$ref": "#/$defs/CameraShot"
        },
        "replay": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Match-time window",
          "title": "Replay"
        },
        "replay_speed": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "title": "Replay Speed",
          "type": "number"
        },
        "highlight": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlight"
        },
        "trail": {
          "default": false,
          "title": "Trail",
          "type": "boolean"
        },
        "speedo": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak speed shown, km/h",
          "title": "Speedo"
        },
        "focus": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pitch-frame point to frame on",
          "title": "Focus"
        }
      },
      "required": [
        "shot"
      ],
      "title": "Camera",
      "type": "object"
    },
    "CameraShot": {
      "description": "Camera presets (build plan 3.7).",
      "enum": [
        "tv_main",
        "spidercam_goal",
        "corner_low",
        "card_close",
        "save_reverse",
        "tactical_high"
      ],
      "title": "CameraShot",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "stat",
        "season",
        "table",
        "fixture",
        "discipline",
        "win_prob",
        "milestone"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One checkable fact. ``numbers`` holds the machine values the Verifier compares against.",
      "properties": {
        "id": {
          "pattern": "^ev\\d+$",
          "title": "Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "value": {
          "description": "Human-readable statement of the fact",
          "title": "Value",
          "type": "string"
        },
        "source": {
          "description": "An event id or a context ref, e.g. season:ash-09:goals",
          "title": "Source",
          "type": "string"
        },
        "numbers": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Numbers",
          "type": "object"
        }
      },
      "required": [
        "id",
        "claim_type",
        "value",
        "source"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FactBox": {
      "additionalProperties": false,
      "description": "The text of a box. Casual viewers see headline and body; analysts open the evidence.",
      "properties": {
        "headline": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "default": "",
          "description": "One or two plain sentences",
          "maxLength": 280,
          "title": "Body",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "analyst": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalystDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "headline"
      ],
      "title": "FactBox",
      "type": "object"
    },
    "Layer": {
      "description": "Which overlay layer a cue belongs to. The lens sweep swaps the three lens layers.",
      "enum": [
        "global",
        "player",
        "club",
        "pundit"
      ],
      "title": "Layer",
      "type": "string"
    },
    "SpeedBadge": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "title": "Player Id",
          "type": "string"
        },
        "speed_kmh": {
          "minimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "season_best": {
          "default": false,
          "title": "Season Best",
          "type": "boolean"
        }
      },
      "required": [
        "player_id",
        "speed_kmh"
      ],
      "title": "SpeedBadge",
      "type": "object"
    },
    "Template": {
      "enum": [
        "fact_box",
        "not_involved",
        "speed_badge",
        "name_tag",
        "replay",
        "timeline_item",
        "brief"
      ],
      "title": "Template",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One timed overlay instruction.",
  "properties": {
    "cue_id": {
      "pattern": "^m\\d{3,}-c\\d{3,}$",
      "title": "Cue Id",
      "type": "string"
    },
    "match_id": {
      "pattern": "^m\\d{3,}$",
      "title": "Match Id",
      "type": "string"
    },
    "moment_id": {
      "anyOf": [
        {
          "pattern": "^m\\d{3,}-mo\\d{2,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Moment Id"
    },
    "t_show": {
      "minimum": 0,
      "title": "T Show",
      "type": "number"
    },
    "duration": {
      "description": "Seconds of playback the cue stays up",
      "exclusiveMinimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "layer": {
      "$ref": "#/$defs/Layer"
    },
    "template": {
      "$ref": "#/$defs/Template"
    },
    "lang": {
      "default": "en",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "title": "Lang",
      "type": "string"
    },
    "player_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required on the player layer",
      "title": "Player Id"
    },
    "team_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required on the club layer",
      "title": "Team Id"
    },
    "priority": {
      "default": 0.0,
      "description": "Importance x relevance",
      "minimum": 0,
      "title": "Priority",
      "type": "number"
    },
    "box": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/Camera"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "badge": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpeedBadge"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "cue_id",
    "match_id",
    "t_show",
    "duration",
    "layer",
    "template"
  ],
  "title": "Cue",
  "type": "object"
}
