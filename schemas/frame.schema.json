{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttman12/matchlens-pl-hackathon/schemas/frame.schema.json",
  "x-schema-version": "1.0.0",
  "additionalProperties": false,
  "description": "One tracking frame, in the **pitch frame** (see ``matchlens.contracts.pitch``).\n\nStored and streamed as JSON Lines, one frame per line, in ``t`` order. Players who are\nnot on the pitch (bench, sent off, substituted) are absent from ``players``.",
  "properties": {
    "t": {
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "ball": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Ball",
      "type": "array"
    },
    "players": {
      "patternProperties": {
        "^[a-z]{3}-\\d{2}$": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        }
      },
      "title": "Players",
      "type": "object"
    }
  },
  "required": [
    "t",
    "ball",
    "players"
  ],
  "title": "Frame",
  "type": "object"
}
