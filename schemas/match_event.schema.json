{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttman12/matchlens-pl-hackathon/schemas/match_event.schema.json",
  "x-schema-version": "1.0.0",
  "$defs": {
    "EventType": {
      "enum": [
        "pass",
        "carry",
        "shot",
        "save",
        "tackle",
        "interception",
        "pressure",
        "foul",
        "card",
        "corner",
        "free_kick",
        "throw_in",
        "goal_kick",
        "goal",
        "kick_off",
        "substitution",
        "offside",
        "period_start",
        "period_end"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "complete",
        "incomplete",
        "out",
        "goal",
        "saved",
        "blocked",
        "off_target",
        "post",
        "won",
        "lost",
        "caught",
        "parried",
        "yellow",
        "second_yellow",
        "red"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Qualifiers": {
      "additionalProperties": true,
      "description": "Optional detail on an event. Fields apply only to the event types noted.\n\nExtra keys are allowed here so the simulator can add detail without a schema\nchange; promote a key to a named field once another module depends on it.",
      "properties": {
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass, carry, shot",
          "title": "Distance M"
        },
        "difficulty": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass: 0 easy to 1 very hard",
          "title": "Difficulty"
        },
        "pressure_on_passer": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass, shot, carry",
          "title": "Pressure On Passer"
        },
        "line_breaking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass: bypasses a defensive line",
          "title": "Line Breaking"
        },
        "pass_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass: ground | lofted | cross | through | long | cut_back",
          "title": "Pass Type"
        },
        "ball_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pass, shot",
          "title": "Ball Speed Kmh"
        },
        "xg": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "shot: expected goals",
          "title": "Xg"
        },
        "shot_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "shot",
          "title": "Shot Speed Kmh"
        },
        "body_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "shot: left_foot | right_foot | head",
          "title": "Body Part"
        },
        "end_height_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "shot: height at goal line",
          "title": "End Height M"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "carry, pressure",
          "title": "Duration S"
        },
        "top_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "carry: peak player speed",
          "title": "Top Speed Kmh"
        },
        "severity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "foul, tackle: how reckless",
          "title": "Severity"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "card, foul: short reason code",
          "title": "Reason"
        },
        "assist_player_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "goal",
          "title": "Assist Player Id"
        },
        "own_goal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "goal",
          "title": "Own Goal"
        },
        "score_home": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "goal: home score after",
          "title": "Score Home"
        },
        "score_away": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "goal: away score after",
          "title": "Score Away"
        },
        "added_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "period_end",
          "title": "Added Time S"
        }
      },
      "title": "Qualifiers",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One on-ball or match event.\n\nCoordinates are in the **attacking frame** of ``team_id`` (see ``matchlens.contracts.pitch``).\n\nConventions:\n- A scoring shot is a ``shot`` with outcome ``goal``, followed by a ``goal`` event at\n  the same ``t`` that names the scorer and the score after.\n- ``related_player_id`` is the other player in a two-player event: the player brought\n  on (substitution), the player fouled (foul), the ball carrier (tackle, pressure) or\n  the shooter (save).",
  "properties": {
    "event_id": {
      "pattern": "^m\\d{3,}-e\\d{4,}$",
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "pattern": "^m\\d{3,}$",
      "title": "Match Id",
      "type": "string"
    },
    "t": {
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "clock": {
      "pattern": "^\\d{1,3}(\\+\\d{1,2})?:\\d{2}$",
      "title": "Clock",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "team_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "player_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "start": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start"
    },
    "end": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receiver_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "pass: intended receiver",
      "title": "Receiver Id"
    },
    "related_player_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Player Id"
    },
    "qualifiers": {
      "$ref": "#/$defs/Qualifiers"
    },
    "possession_id": {
      "anyOf": [
        {
          "pattern": "^m\\d{3,}-p\\d{3,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Possession Id"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "t",
    "period",
    "clock",
    "type"
  ],
  "title": "MatchEvent",
  "type": "object"
}
