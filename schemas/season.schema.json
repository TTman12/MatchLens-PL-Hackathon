{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttman12/matchlens-pl-hackathon/schemas/season.schema.json",
  "x-schema-version": "1.0.0",
  "$defs": {
    "Fixture": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "pattern": "^m\\d{3,}$",
          "title": "Match Id",
          "type": "string"
        },
        "matchday": {
          "minimum": 1,
          "title": "Matchday",
          "type": "integer"
        },
        "home_id": {
          "pattern": "^[a-z]{3}$",
          "title": "Home Id",
          "type": "string"
        },
        "away_id": {
          "pattern": "^[a-z]{3}$",
          "title": "Away Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "played",
            "scheduled",
            "live"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "match_id",
        "matchday",
        "home_id",
        "away_id",
        "status"
      ],
      "title": "Fixture",
      "type": "object"
    },
    "PlayerSeasonStats": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "pattern": "^[a-z]{3}-\\d{2}$",
          "title": "Player Id",
          "type": "string"
        },
        "team_id": {
          "pattern": "^[a-z]{3}$",
          "title": "Team Id",
          "type": "string"
        },
        "appearances": {
          "minimum": 0,
          "title": "Appearances",
          "type": "integer"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "goals": {
          "minimum": 0,
          "title": "Goals",
          "type": "integer"
        },
        "assists": {
          "minimum": 0,
          "title": "Assists",
          "type": "integer"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "passes": {
          "minimum": 0,
          "title": "Passes",
          "type": "integer"
        },
        "pass_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Accuracy"
        },
        "avg_pass_difficulty": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Pass Difficulty"
        },
        "top_speed_kmh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Speed Kmh"
        },
        "distance_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "yellow_cards": {
          "description": "Yellows counting toward the next ban",
          "minimum": 0,
          "title": "Yellow Cards",
          "type": "integer"
        },
        "red_cards": {
          "minimum": 0,
          "title": "Red Cards",
          "type": "integer"
        },
        "last_goal_matchday": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For milestones",
          "title": "Last Goal Matchday"
        },
        "suspended_for": {
          "description": "Upcoming matches this player is banned from",
          "items": {
            "pattern": "^m\\d{3,}$",
            "type": "string"
          },
          "title": "Suspended For",
          "type": "array"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "appearances",
        "minutes",
        "goals",
        "assists",
        "shots",
        "passes",
        "yellow_cards",
        "red_cards"
      ],
      "title": "PlayerSeasonStats",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "home": {
          "minimum": 0,
          "title": "Home",
          "type": "integer"
        },
        "away": {
          "minimum": 0,
          "title": "Away",
          "type": "integer"
        }
      },
      "required": [
        "home",
        "away"
      ],
      "title": "Score",
      "type": "object"
    },
    "SeasonRules": {
      "additionalProperties": false,
      "properties": {
        "points_for_win": {
          "default": 3,
          "title": "Points For Win",
          "type": "integer"
        },
        "points_for_draw": {
          "default": 1,
          "title": "Points For Draw",
          "type": "integer"
        },
        "yellow_card_ban_threshold": {
          "default": 5,
          "description": "Yellows that trigger a ban; the count resets after the ban",
          "title": "Yellow Card Ban Threshold",
          "type": "integer"
        },
        "ban_length_matches": {
          "default": 1,
          "title": "Ban Length Matches",
          "type": "integer"
        }
      },
      "title": "SeasonRules",
      "type": "object"
    },
    "TableRow": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "team_id": {
          "pattern": "^[a-z]{3}$",
          "title": "Team Id",
          "type": "string"
        },
        "played": {
          "minimum": 0,
          "title": "Played",
          "type": "integer"
        },
        "won": {
          "minimum": 0,
          "title": "Won",
          "type": "integer"
        },
        "drawn": {
          "minimum": 0,
          "title": "Drawn",
          "type": "integer"
        },
        "lost": {
          "minimum": 0,
          "title": "Lost",
          "type": "integer"
        },
        "goals_for": {
          "minimum": 0,
          "title": "Goals For",
          "type": "integer"
        },
        "goals_against": {
          "minimum": 0,
          "title": "Goals Against",
          "type": "integer"
        },
        "goal_difference": {
          "title": "Goal Difference",
          "type": "integer"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "form": {
          "description": "Most recent last",
          "items": {
            "enum": [
              "W",
              "D",
              "L"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Form",
          "type": "array"
        }
      },
      "required": [
        "position",
        "team_id",
        "played",
        "won",
        "drawn",
        "lost",
        "goals_for",
        "goals_against",
        "goal_difference",
        "points",
        "form"
      ],
      "title": "TableRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``season.json``: everything the agents know before kick-off of the streamed match.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "league_id": {
      "title": "League Id",
      "type": "string"
    },
    "season_id": {
      "title": "Season Id",
      "type": "string"
    },
    "through_matchday": {
      "description": "Last matchday included in table and stats",
      "minimum": 0,
      "title": "Through Matchday",
      "type": "integer"
    },
    "rules": {
      "$ref": "#/$defs/SeasonRules"
    },
    "table": {
      "items": {
        "$ref": "#/$defs/TableRow"
      },
      "title": "Table",
      "type": "array"
    },
    "fixtures": {
      "items": {
        "$ref": "#/$defs/Fixture"
      },
      "title": "Fixtures",
      "type": "array"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/PlayerSeasonStats"
      },
      "title": "Players",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "league_id",
    "season_id",
    "through_matchday",
    "table",
    "fixtures",
    "players"
  ],
  "title": "Season",
  "type": "object"
}
