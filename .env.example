# Copy to .env for local development. Never commit .env.
# Every value is read from the environment only; leave a line empty to skip it.
# With nothing set, the agents run offline on deterministic templates (no credentials).

# offline | foundry. Defaults to foundry when AZURE_AI_PROJECT_ENDPOINT is set.
MATCHLENS_PROVIDER=

# Microsoft Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
# Model deployment names in that project: fast for the lens agents and Translator,
# strong for the Pundit and the Verifier's repair agent (falls back to the fast one).
AZURE_AI_MODEL_FAST=
AZURE_AI_MODEL_STRONG=

# Optional: Azure AI Content Safety endpoint for the Club lens tone check
# (otherwise a local word list is used).
AZURE_CONTENT_SAFETY_ENDPOINT=
# Optional: Application Insights connection string linked to the Foundry project, for traces.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Sign-in uses DefaultAzureCredential: `az login` locally, a managed identity in Azure.
# Only for a service principal (e.g. CI) set these as well; keep the secret out of git.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
